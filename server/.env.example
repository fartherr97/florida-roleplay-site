# HTTP port the API (and the built client) is served on.
PORT=4000

# MariaDB host — the container or machine running the database.
DB_HOST=localhost
# MariaDB port.
DB_PORT=3306
# Database user with read/write on the schema below.
DB_USER=root
# Password for that user. Never commit the real value.
DB_PASSWORD=
# Schema name, created by `npm run db:init`.
DB_NAME=florida_rp
# Maximum pooled connections.
DB_CONNECTION_LIMIT=5

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Development-only: the Discord user id the API treats as the caller until
# OAuth is wired up. Ignored when NODE_ENV=production.
DEV_USER_ID=198273645500000000
