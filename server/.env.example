# HTTP port the API (and the built client) is served on.
PORT=4000

# MariaDB host — the container or machine running the database.
DB_HOST=localhost
# MariaDB port.
DB_PORT=3306
# Database user with read/write on the schema below.
DB_USER=root
# Password for that user. Never commit the real value.
DB_PASSWORD=
# Schema name, created by `npm run db:init`.
DB_NAME=florida_rp
# Maximum pooled connections.
DB_CONNECTION_LIMIT=5

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Development-only: the Discord user id the API treats as the caller until
# OAuth is wired up. Ignored when NODE_ENV=production.
DEV_USER_ID=198273645500000000

# Shared secret the roster bot presents as `Authorization: Bearer <token>` on
# the /api/roster/sync endpoints and on /api/apply/bot/*. Generate a long random
# value and give it only to the bot. Leave it unset and those endpoints are
# refused with 503 rather than left open — never blank this out to "make it work".
BOT_TOKEN=

# Optional. Where to push an application the moment it is submitted, so the
# Discord embed appears without waiting for the bot's next poll.
#
# This is only ever an optimisation. Every dispatch is written to the
# application_dispatches table regardless, and the bot collecting them from
# GET /api/apply/bot/outbox is the actual contract — so leaving this unset costs
# nothing but the poll interval, and a failed push costs nothing at all.
#
# The site posts here with the same Bearer BOT_TOKEN above.
BOT_DISPATCH_URL=

# Optional: serve a department site from its own hostname as well as from
# /departments/<id>/hub. Comma-separated host=department pairs. A real subdomain
# already resolves without this (fhp.floridarp.gg → fhp); use the map only for
# hosts that don't follow that shape.
DEPARTMENT_MAP=
