# HTTP port the API (and the built client) is served on.
PORT=4000

# The Postgres connection string. Railway and Northflank both provide exactly
# this — reference their variable rather than copying the value, so a rotated
# password does not need a redeploy. When it is set, every DB_* var below is
# ignored.
DATABASE_URL=

# Local development only, used when DATABASE_URL is unset.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# Password for that user. Never commit the real value.
DB_PASSWORD=
# Database name, created by your Postgres — `npm run db:init` fills in its tables.
DB_NAME=florida_rp
# Maximum pooled connections. Managed Postgres plans cap total connections, so
# this times the number of running instances has to stay under that cap.
DB_CONNECTION_LIMIT=5

# TLS is required for any host that is not local, and is not optional on a
# managed provider. `require` forces it on, `disable` forces it off (local only).
# Leave unset to decide from the host.
DB_SSL=
# Railway's internal hostnames present a certificate that does not match, so
# verification is relaxed there — the traffic is still encrypted. This is not a
# way to turn TLS off.
DB_SSL_REJECT_UNAUTHORIZED=

# Comma-separated list of browser origins allowed to call the API.
# In production this is the site's own origin: https://flrp.us
CORS_ORIGIN=http://localhost:5173

# Development-only: the Discord user id the API treats as the caller until
# OAuth is wired up. Ignored when NODE_ENV=production.
DEV_USER_ID=198273645500000000

# Shared secret the roster bot presents as `Authorization: Bearer <token>` on
# the /api/roster/sync endpoints. Generate a long random value and give it only
# to the bot. Leave it unset and those endpoints are refused with 503 rather
# than left open — never blank this out to "make it work".
BOT_TOKEN=


# ------------------------------------------------------------------ #
# Discord OAuth — how members sign in.
#
# Create an application at https://discord.com/developers/applications.
# All five values must be set for sign-in to work; if any is missing the site
# stays up and the sign-in button explains it is not configured yet.
# ------------------------------------------------------------------ #

# OAuth2 → General → Client ID and Client Secret. The secret authenticates the
# code exchange; never commit the real value.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# A bot token for the same application (Bot → Reset Token). It is used only to
# read guild membership and roles — the bot needs the "Server Members Intent"
# on and must be a member of the guild. Never commit the real value. This can be
# the same bot the roster sync uses, or a separate one.
DISCORD_BOT_TOKEN=

# The Discord server (guild) whose members can sign in. Right-click the server
# icon → Copy Server ID (Developer Mode on).
DISCORD_GUILD_ID=

# The OAuth2 redirect. Must be added verbatim under OAuth2 → Redirects in the
# Discord portal. In production this is the site's own /api/auth/callback:
#   https://flrp.us/api/auth/callback
# For local development against the Vite dev server:
#   http://localhost:5173/api/auth/callback
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Optional: serve a department site from its own hostname as well as from
# /departments/<id>/hub. Comma-separated host=department pairs. A real subdomain
# already resolves without this (fhp.flrp.us → fhp); use the map only for
# hosts that don't follow that shape.
DEPARTMENT_MAP=

# --- Tebex store (optional) -------------------------------------------------
# The custom storefront reads packages from Tebex and hands checkout back to
# Tebex; nothing here charges a card. All three are found in the Tebex control
# panel. The store stays dormant (the /store page shows an empty state) until
# TEBEX_STORE_TOKEN is set, so leaving these blank is safe.

# The PUBLIC webstore token that identifies your store to the Tebex Headless
# API. Tebex panel → your project → the "Public token"/"Webstore identifier".
# It is not a secret (it rides in the API URL) but is kept server-side anyway.
TEBEX_STORE_TOKEN=

# The webhook SIGNING SECRET, from Tebex panel → Developers → Webhooks. Used to
# verify that an incoming payment webhook really came from Tebex. Keep secret;
# never commit the real value. Without it, real payment webhooks are refused.
TEBEX_WEBHOOK_SECRET=

# Optional: the public store URL used for "Open in Tebex" links in Store
# Management. Defaults to https://<TEBEX_STORE_TOKEN>.tebex.io when unset.
TEBEX_STORE_URL=

# Optional: the site's own public origin, used to build the checkout return
# URLs (e.g. https://www.flrp.us). Defaults to https://www.flrp.us. Shared with
# the support-webhook links, so it may already be set.
SITE_URL=
