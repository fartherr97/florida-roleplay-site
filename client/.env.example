# The Discord bot's REST API. The dashboard under /management/bot talks to this
# directly from the browser; it never goes through this repo's own Express API.
#
# IMPORTANT — in production this must be a subdomain of whatever domain serves
# the site (api.example.com for example.com). The API's session cookies are
# SameSite=Lax, so on any other domain the browser silently drops them: every
# signed-in request 401s, with no CORS error and nothing wrong-looking in the
# network tab. The dashboard checks this at runtime and says so, but the fix is
# a deployment one.
VITE_API_URL=http://localhost:4000

# NOTE for local development: this repo's own Express server also defaults to
# port 4000 (see server/.env.example), so running both at once needs one of them
# moved. Either set PORT=4001 in server/.env, or point this at whichever port
# the bot API is actually listening on.
